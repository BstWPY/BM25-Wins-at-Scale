# Repository and data paths
PROJECT_ROOT=/absolute/path/to/workspace
URAG_ROOT=/absolute/path/to/RAG_position_paper
U_DATA_ROOT=/absolute/path/to/experiment_data
U_RESULTS_ROOT=/absolute/path/to/experiment_results
ENTERPRISE_RAG_BENCH_ROOT=/absolute/path/to/EnterpriseRAG-Bench
MODEL_ROOT=/absolute/path/to/models

# Optional method checkouts when they are not installed as packages
LIGHTRAG_ROOT=/absolute/path/to/LightRAG
LINEARRAG_ROOT=/absolute/path/to/LinearRAG

# OpenAI-compatible local model services
U_LLM_ENDPOINT=http://localhost:8000/v1
U_EMBED_ENDPOINT=http://localhost:8001/v1

# Optional external judge; required only by judge scripts
GW_BASE=https://judge-api.example.invalid/v1
GW_KEY=replace-with-your-own-key
GW_MODEL=replace-with-your-judge-model

# Optional external harness executables
CODEX_BIN=/absolute/path/to/codex
PI_BIN=/absolute/path/to/pi

# Optional accelerator selection for LinearRAG preprocessing
LINEARRAG_CUDA_VISIBLE_DEVICES=0

# Optional corpus preprocessing parallelism
CORPUS_META_WORKERS=32
